# GitHub Pages 배포 경로. 레포지토리 이름이 MabiKumaWeb 이 아니면 바꾼다.
# 커스텀 도메인을 쓰거나 user 사이트(<user>.github.io)라면 "/" 로 둔다.
VITE_BASE_PATH=/MabiKumaWeb/

# 키를 대신 들고 있는 Cloudflare Worker 주소. worker/README.md 참고.
# 이 값은 비밀이 아니라 공개 URL 이므로 GitHub Actions 에서도 Secret 이 아니라
# Variable(vars) 로 넣는다.
VITE_PROXY_URL=

# 프록시를 쓰지 않고 자기 키로 직접 호출할 때의 대상.
# 비워두면 개발 중에는 /nexon-api (Vite 프록시), 배포본에서는 https://open.api.nexon.com.
VITE_API_BASE_URL=

# 로컬 개발 편의용 기본 API 키(선택).
# 주의: VITE_ 변수는 번들에 그대로 박힌다. 공개 배포 빌드에는 절대 넣지 말 것 —
# 그래서 배포 워크플로는 이 값을 주입하지 않는다. 공개 사이트의 키는 프록시가 들고 있어야 한다.
VITE_NEXON_API_KEY=
